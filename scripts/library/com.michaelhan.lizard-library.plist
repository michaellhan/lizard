<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Publishes newly finished heads-up flops every 6 hours. Installed copy: ~/Library/LaunchAgents (docs/DEPLOYMENT.md §4).
     macOS decides what a launchd job may read under ~/Desktop by the program launchd starts. On this Mac bash may (as
     com.instatweet.topup shows) and zsh may not ("can't open input file"), so bash starts slot.sh, which is a zsh script.
     The log stays in ~/Library/Logs: app.hclubs.refresh, which logs under ~/Desktop, exits 78 without starting. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.michaelhan.lizard-library</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/bin/zsh /Users/mhan/Desktop/projects/gtosolver/.work/bin/slot.sh /Users/mhan/Desktop/projects/lizard/scripts/library/publish.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/mhan/Desktop/projects/lizard</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>StartInterval</key><integer>21600</integer>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/mhan/Library/Logs/lizard-library.log</string>
  <key>StandardErrorPath</key><string>/Users/mhan/Library/Logs/lizard-library.log</string>
</dict></plist>
